{
  "name": "@rksp/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --ignore-pattern \"src/**/*.d.ts\""
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "vitest": "^3.1.2"
  }
}
