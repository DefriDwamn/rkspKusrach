{
  "name": "@rksp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "ingest": "tsx src/scripts/ingest-documents.ts",
    "index": "tsx src/scripts/index-documents.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fuzz": "vitest run test/chat-session-store.fuzz.test.ts test/chat.route.fuzz.test.ts test/ingestion.fuzz.test.ts test/rag.service.fuzz.test.ts test/vector-index.fuzz.test.ts",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@rksp/shared": "0.1.0",
    "apache-arrow": "^19.0.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.2.1",
    "ollama": "^0.6.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.2",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.3",
    "vitest": "^3.1.2"
  }
}
